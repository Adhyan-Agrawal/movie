# Lumora mobile (Expo). EXPO_PUBLIC_* values are embedded in the client bundle —
# only ever put the PUBLIC anon key here, never the service-role key.
EXPO_PUBLIC_SUPABASE_URL=https://kxryqybzblowseasvcrm.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
# Public web app — used for the playback bridge, share links and legal pages.
EXPO_PUBLIC_WEB_URL=https://hulkofyt.eu.org

# Public AdMob IDs only. Demo units are used unless TEST_ADS=false and all IDs are valid.
# Development builds always use demo units. Production IDs require an Android rebuild.
EXPO_PUBLIC_ADMOB_TEST_ADS=true
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-3940256099942544~3347511713
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=ca-app-pub-3940256099942544/9214589741
EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL_ID=ca-app-pub-3940256099942544/1033173712
