{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lumora-watch-party",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "preview_urls": false,
  "upload_source_maps": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "WATCH_PARTY_ROOMS",
        "class_name": "WatchPartyRoom"
      }
    ]
  },
  "exports": {
    "WatchPartyRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "secrets": {
    "required": [
      "WATCH_PARTY_SECRET",
      "ALLOWED_ORIGINS"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
