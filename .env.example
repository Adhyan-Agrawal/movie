# Lumora environment (Section 6). Copy to .env.local and fill in.
# Never commit real secrets. Public vars are exposed to the browser.

# --- Public ---
NEXT_PUBLIC_APP_NAME=Lumora
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (public). App runs with mock data until these are set.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only (never sent to the browser) ---
SUPABASE_SERVICE_ROLE_KEY=
TMDB_API_KEY=
TMDB_API_BASE_URL=https://api.themoviedb.org/3
