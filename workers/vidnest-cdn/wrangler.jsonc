{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "lumora-vidnest-cdn",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "preview_urls": false,
  "secrets": {
    "required": [
      "VIDNEST_API_SECRET",
      "VIDNEST_ORIGIN_URL"
    ]
  }
}
