{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["../../src/*"],
      "@watch-party/*": ["../../src/features/watch-party/*"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@cloudflare/vitest-plugin/types", "node"]
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "../../src/features/watch-party/protocol.ts",
    "../../src/features/watch-party/tickets.ts",
    "../../src/app/api/watch-party/route.ts"
  ]
}
