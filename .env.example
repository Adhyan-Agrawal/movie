# Lumora local-development template. Never commit real secrets.
# Netlify: configure application values in the UI, not netlify.toml.
# NEXT_PUBLIC_* values need Builds + Functions scope and enter the browser bundle.
# Private keys need Functions scope only; do not promote them to public variables.

# --- Public ---
NEXT_PUBLIC_APP_NAME=Lumora
# Local development only. Netlify production requires the operator's verified HTTPS origin.
# Do not infer it from Host/X-Forwarded-Host or invent a netlify.app site name.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth requires this public pair at BOTH build and runtime, from the same Supabase project.
# Use only its anon/publishable key here, never a service-role or sb_secret_ key.
# Configure Supabase email sign-in, email confirmation/delivery, Site URL and /auth/callback redirect separately.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only (Netlify Functions scope; never sent to the browser) ---
# Optional for basic sign-in/sign-up/session verification. Required only for privileged
# storage/signing, sync/admin jobs and best-effort welcome email settings; never bypass RLS for login.
SUPABASE_SERVICE_ROLE_KEY=
TMDB_API_KEY=
TMDB_API_BASE_URL=https://api.themoviedb.org/3
# Wyzie Subs API key. Get one at https://store.wyzie.io/redeem
WYZIE_API_KEY=
# Optional stable signing secret so issued subtitle URLs survive API key rotation.
WYZIE_SUBTITLE_TOKEN_SECRET=
# Private 32+ character signing key for Lumora playback capabilities, NOT an upstream API credential.
# VIDNEST_API_URL is test-only; setting it cannot select a production provider.
VIDNEST_API_SECRET=
# Shared HMAC secret (32+ characters) used only by the ticket API and Watch Party Worker.
WATCH_PARTY_SECRET=
# Nonsecret HTTPS origin of the separate Watch Party service, no /v1/ws path.
# Netlify Builds + Functions scope: needed at build for WebSocket CSP and at runtime for tickets.
# Netlify Functions do not host this persistent WebSocket service.
# Worker also needs matching WATCH_PARTY_SECRET, WATCH_PARTY_ROOMS and exact ALLOWED_ORIGINS.
# These settings do not provision the backend, and guest rooms do not require Supabase.
WATCH_PARTY_WORKER_URL=

# Adsterra ad zones (Section 11). Each value is the zone "key" from the
# Adsterra dashboard banner code (atOptions.key) for that format.
# Without a key the slot shows a labeled "Advertisement" placeholder.
ADSTERRA_KEY_LEADERBOARD=
ADSTERRA_KEY_RECTANGLE=
ADSTERRA_KEY_PREROLL=
