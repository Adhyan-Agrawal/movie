# Local OpenNext/Wrangler bindings only. Never put real values in this example.
# Copy to .dev.vars only after .dev.vars* is ignored by Git.
NEXTJS_ENV=development

NEXT_PUBLIC_APP_NAME=Lumora
NEXT_PUBLIC_APP_URL=http://localhost:8787
