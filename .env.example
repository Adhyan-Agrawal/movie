# Lumora environment (Section 6). Copy to .env.local and fill in.
# Never commit real secrets. Public vars are exposed to the browser.

# --- Public ---
NEXT_PUBLIC_APP_NAME=Lumora
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (public). App runs with mock data until these are set.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only (never sent to the browser) ---
SUPABASE_SERVICE_ROLE_KEY=
TMDB_API_KEY=
TMDB_API_BASE_URL=https://api.themoviedb.org/3

# Adsterra ad zones (Section 11). Each value is the zone "key" from the
# Adsterra dashboard banner code (atOptions.key) for that format.
# Without a key the slot shows a labeled "Advertisement" placeholder.
ADSTERRA_KEY_LEADERBOARD=b1eebe8f0c49ff6b548d2ff5a184c45d
ADSTERRA_KEY_RECTANGLE=e11ac1e097a2f12de3970ce204467cba
ADSTERRA_KEY_PREROLL=https://pl22647020.profitableratecpmnetwork.com/d384d4fd612d63754d6973b8a5ab9c73/invoke.js